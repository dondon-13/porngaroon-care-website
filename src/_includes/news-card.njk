<a class="news-card" href="{{ post.url }}">
  <img src="{{ post.data.cover or '/images/site/news-default.jpg' }}" alt="" width="640" height="360" loading="lazy" style="object-position: center {{ post.data.cover_position or 'center' }}">
  <span class="news-card__meta">{{ post.data.category }} · {{ post.date | thaiDate }}</span>
  <span class="news-card__title">{{ post.data.title }}</span>
  {%- if post.data.summary %}<span class="news-card__summary">{{ post.data.summary }}</span>{% endif %}
</a>
