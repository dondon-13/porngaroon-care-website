---
layout: base.njk
permalink: /
---
{%- set cross = '<path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/>' %}
<section class="hero">
  <svg class="hero__wave-top" aria-hidden="true" viewBox="0 0 1440 140" preserveAspectRatio="none"><path d="M300 0 C 520 120, 920 120, 1140 0 Z"/></svg>
  <svg class="hero__wave-bottom" aria-hidden="true" viewBox="0 0 1440 220" preserveAspectRatio="none"><path class="w1" d="M0 60 C 300 220, 900 220, 1440 40 L1440 220 L0 220 Z"/><path class="w2" d="M0 130 C 400 230, 1000 210, 1440 110 L1440 220 L0 220 Z"/></svg>
  <svg class="hero__cross hero__cross--a" aria-hidden="true" viewBox="0 0 24 24">{{ cross | safe }}</svg>
  <svg class="hero__cross hero__cross--b" aria-hidden="true" viewBox="0 0 24 24">{{ cross | safe }}</svg>
  <div class="wrap hero__inner">
    <div class="hero__text">
      <h1 class="hero__title">{{ home.hero_title }}</h1>
      <p class="hero__subtitle">{{ home.hero_subtitle | nl2br | safe }}</p>
      <p class="hero__lead">{{ home.hero_text }}</p>
      <div class="btn-row">
        <a class="btn btn--primary btn--lg" href="{{ settings.phone | telHref }}">โทร {{ settings.phone }}</a>
        <a class="btn btn--outline btn--lg" href="#pricing">เช็คราคา</a>
      </div>
    </div>
    <div class="hero__photo"><img src="{{ home.hero_image }}" alt="ผู้ดูแลของพรการุญเฝ้าไข้สวมกอดผู้สูงอายุที่ดูแล" width="900" height="900"></div>
  </div>
</section>

<section class="trust" aria-label="เหตุผลที่ไว้วางใจได้">
  <div class="wrap trust__grid">
    {%- set icons = [
      '<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/>',
      '<path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/><path d="M7 12h3l1-2 2 4 1-2h3"/>',
      '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 15c3 0 6 1.8 6 5"/>',
      '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>'
    ] %}
    {%- for t in home.trust_points %}
    <div class="trust__item">
      <svg viewBox="0 0 24 24" aria-hidden="true">{{ icons[loop.index0 % 4] | safe }}</svg>
      <div><h3>{{ t.title }}</h3><p>{{ t.text }}</p></div>
    </div>
    {%- endfor %}
  </div>
</section>

<section class="types wrap" aria-labelledby="types-title">
  <h2 id="types-title" class="h2 center">{{ home.types_title }}</h2>
  <div class="types__grid">
    <div class="types__item">
      <img src="{{ home.type_walking_image }}" alt="ผู้ดูแลพยุงผู้สูงอายุเดินด้วยที่ช่วยเดิน" width="900" height="600" loading="lazy">
      <a class="btn btn--primary types__btn" href="#services">คนไข้เดินได้</a>
    </div>
    <div class="types__item">
      <img src="{{ home.type_bedridden_image }}" alt="ทีมดูแลผู้ป่วยติดเตียงที่บ้าน" width="900" height="600" loading="lazy">
      <a class="btn btn--primary types__btn" href="#services">คนไข้ติดเตียง</a>
    </div>
  </div>
</section>

<section id="services" class="services wrap" aria-labelledby="services-title">
  <div class="section-head center">
    <h2 id="services-title" class="h2">บริการของเรา</h2>
    <p>{{ services.intro }}</p>
  </div>
  <div class="services__grid">
    {%- for s in services.items %}
    <article class="service"><h3>{{ s.title }}</h3><p>{{ s.text }}</p></article>
    {%- endfor %}
  </div>
</section>

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <h2 id="pricing-title" class="h2">{{ pricing.title }}</h2>
    <p class="pricing__intro">{{ pricing.intro }}<br>{{ pricing.note }}</p>
    <div class="pricing__grid">
      {%- for p in pricing.plans %}
      <div class="plan">
        <h3>{{ p.name }}</h3>
        <p>{{ p.detail }}</p>
        <a class="btn btn--primary btn--block" href="{{ p.line_message | lineMessage(settings.line_id) }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8 9.6 9.6 0 0 1-3.5-.7L4 20l1.3-3.6A7.7 7.7 0 0 1 3 11.5a8.4 8.4 0 0 1 9-8 8.4 8.4 0 0 1 9 8z"/></svg>
          สอบถามราคาทาง LINE
        </a>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if cases.items.length %}
<section class="cases wrap" aria-labelledby="cases-title" data-carousel>
  <div class="cases__head">
    <h2 id="cases-title" class="h2">{{ cases.title }}</h2>
    <div class="cases__controls">
      <span class="cases__count" data-count aria-live="polite"></span>
      <button class="round-btn" type="button" data-prev aria-label="เคสก่อนหน้า"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="round-btn round-btn--solid" type="button" data-next aria-label="เคสถัดไป"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
  </div>
  <div class="cases__viewport" data-viewport>
    <ul class="cases__track" data-track>
      {%- for c in cases.items %}
      <li class="case">
        <img src="{{ c.image }}" alt="" width="720" height="480" loading="lazy">
        <p>"{{ c.caption }}"</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
  <div class="cases__dots" data-dots></div>
</section>
{%- endif %}

<section id="news" class="news-home" aria-labelledby="news-title">
  <div class="wrap">
    <div class="cases__head">
      <h2 id="news-title" class="h2">ข้อมูลข่าวสาร</h2>
      <a class="btn btn--outline" href="/news/">ดูข้อมูลข่าวสารทั้งหมด</a>
    </div>
    {%- if collections.posts.length %}
    <div class="news-grid">
      {%- for post in collections.posts | head(3) %}{% include "news-card.njk" %}{% endfor %}
    </div>
    {%- else %}
    <a class="news-empty" href="/news/">
      <img src="/images/site/news-default.jpg" alt="" width="1200" height="750" loading="lazy">
      <span>บทความความรู้การดูแลผู้สูงอายุและผู้ป่วย กำลังจะมาเร็ว ๆ นี้</span>
    </a>
    {%- endif %}
  </div>
</section>

<section id="faq" class="faq wrap" aria-labelledby="faq-title">
  <h2 id="faq-title" class="h2">คำถามที่พบบ่อย</h2>
  {%- for f in faq.items %}
  <details><summary>{{ f.question }}</summary><p>{{ f.answer }}</p></details>
  {%- endfor %}
</section>

<section id="about" class="about" aria-labelledby="about-title">
  <div class="about__inner">
    <div class="about__text">
      <img class="about__logo" src="/images/site/logo.png" alt="โลโก้พรการุญเฝ้าไข้" width="150" height="150" loading="lazy">
      <h2 id="about-title">{{ home.about_title }}</h2>
      <p class="about__sub">{{ home.about_subtitle }}</p>
      <p>{{ home.about_text_1 }}</p>
      <p>{{ home.about_text_2 }}</p>
    </div>
    <div class="about__photo">
      <div class="about__shape" aria-hidden="true"></div>
      <img src="{{ home.about_image }}" alt="ผู้ดูแลพรการุญเฝ้าไข้ช่วยผู้สูงอายุฝึกเดินที่บ้าน" loading="lazy">
      <div class="about__corner" aria-hidden="true"></div>
    </div>
  </div>
</section>
